# Your keys. Set Up.command fills this in for you as .env (never shared).
# Every key is optional.

# Tailored drafts: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# More listings: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Notion tracker (Set Up creates the database and fills in the ID)
NOTION_TOKEN=
NOTION_DATABASE_ID=
